Exercícios:

1) 

db.restaurantes.aggregate([
  { 
    $match: { borough: 'Bronx' } 
  }
])

2)

db.restaurantes.aggregate([
  {
    $match: {borough: 'Manhattan'	}
  },
  {
    $project: {
      _id: 0,
      name: 1,
      borough: 1,
      cuisine: 1
    }
  }
])

3)


db.restaurantes.aggregate([
  {
    $match: {borough: 'Brooklyn'	}
  },
  {
    $sort: {name: 1}
  },
  {
    $limit: 5
  },
  {
    $project: {
      _id: 0,
      name: 1,
      borough: 1,
    }
  }
])

4)

db.restaurantes.aggregate([
  {
    $match:
    {
      borough: 'Bronx'
    }
  },
  {
    $match:
    {
      cuisine: 'Bakery'
    }
  }
])

5)

db.restaurantes.aggregate([
  { 
    $sort: { name: -1 } 
  },
  { 
    $limit: 10 
  },
  { 
    $project: { 
      _id: 0, 
      name: 1, 
      cuisine: 1 
    }
  }
])


6)

db.restaurantes.aggregate([
  { $match: { borough: 'Queens' } },
  { $sort: { 'address.zipcode': 1 } },
  { $project: { _id: 0, name: 1, 'address.zipcode': 1, borough: 1 } }
])


7)

db.restaurantes.aggregate([
  {
    $match: {
      borough: { $in: ["Bronx", "Brooklyn"] },
      cuisine: "American "
    }
  }
])

Variação do 7

db.restaurantes.aggregate([
  {
    $match: {
      borough: { $in: ["Bronx", "Brooklyn"] },
      cuisine: { $regex: /^American/ }
    }
  }
])

8)

db.restaurantes.aggregate([
  {
    $project: {
      _id: 0,
      name: 1,
      fullAddress: { $concat: ["$address.building", " - ", "$address.street"] },
      zipcode: "$address.zipcode"
    }
  },
  {
    $match: { zipcode: "10019" }
  },
  {
    $sort: { name: 1 }
  },
  {
    $project: {
      zipcode: 0
    }
  }
])






